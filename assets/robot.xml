<mujoco model="robot_lab_balance">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <default><joint damping="0.8"/><geom friction="1.2 0.1 0.1" condim="3" rgba="0.35 0.55 0.8 1"/></default>
  <worldbody>
    <light pos="0 -3 4"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.85 0.85 0.85 1"/>
    <body name="torso" pos="0 0 0.8">
      <freejoint/>
      <geom name="torso_geom" type="box" size="0.12 0.08 0.22" mass="2.0"/>
      <body name="left_leg" pos="0 0.10 -0.22">
        <joint name="left_hip" axis="0 1 0" range="-0.8 0.8" limited="true"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.045" mass="0.6"/>
        <geom name="left_foot" type="box" pos="0.06 0 -0.42" size="0.13 0.065 0.035" mass="0.2"/>
      </body>
      <body name="right_leg" pos="0 -0.10 -0.22">
        <joint name="right_hip" axis="0 1 0" range="-0.8 0.8" limited="true"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.045" mass="0.6"/>
        <geom name="right_foot" type="box" pos="0.06 0 -0.42" size="0.13 0.065 0.035" mass="0.2"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_motor" joint="left_hip" gear="35" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="right_motor" joint="right_hip" gear="35" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
